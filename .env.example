DATABASE_URL=postgresql+psycopg://bounty:bounty@localhost:5432/bounty
PUBLIC_URL=http://localhost:8000
SESSION_SECRET=replace-with-a-long-random-string

# EVE SSO app from https://developers.eveonline.com/ (callback: $PUBLIC_URL/callback,
# scopes: esi-wallet.read_character_wallet.v1)
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Character ID that receives deposits and sends payouts (not a name: set whatever character you use)
RECEIVING_CHARACTER_ID=
# Comma-separated character IDs allowed to see the payout queue
ADMIN_CHARACTER_IDS=

MIN_BOUNTY_ISK=5000000
HOST_FEE_PERMILLE=25
PAYOUT_RATIO_PERCENT=20
MIN_HUNTER_AGE_DAYS=90
MIN_HUNTER_KILLS=10
CLAIM_HOLD_HOURS=72
DEPOSIT_CODE_PREFIX=BNTY-
MATCH_DEPOSITS_BY_SENDER=false
USER_AGENT=zkb-bounty/0.1 (contact: set-an-admin-contact-here)
