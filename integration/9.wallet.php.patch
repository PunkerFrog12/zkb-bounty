             continue;
         }
+        if (stripos((string) @$row['reason'], 'BNTY-') !== false) {
+            // Bounty deposit: credited by the zkb-bounty service, not ad-free time.
+            $mdb->set('payments', $row, ['paymentApplied' => 1, 'months' => 'bounty deposit']);
